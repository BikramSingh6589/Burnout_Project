{
  "manifest_version": 3,
  "name": "Burnout Guard",
  "version": "1.0.0",
  "description": "Track your burnout daily with streak and wellness reminders.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://burnout-project-xbf1.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "https://burnout-project-xbf1.vercel.app/*"
      ],
      "js": ["contentScript.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
