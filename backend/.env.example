# Backend Environment Configuration
# Copy this file to .env and replace placeholder values.

# Port where the Express backend listens.
PORT=5001

# MongoDB Atlas connection string.
# Replace <username>, <password>, and <database> with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority

# OPTIONAL: DNS servers used for MongoDB Atlas SRV lookups.
# Keep this if your local DNS returns querySrv ECONNREFUSED.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT secret used for signing tokens.
JWT_SECRET=your_jwt_secret_here

# Google OAuth credentials for Google Sign-In.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OPTIONAL: Email account credentials for future email features.
# If one value is provided, both must be set.
# For Gmail, use an app password, not your normal account password.
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=Burnout Wellness <your_email@example.com>

# Local development environment.
NODE_ENV=development
