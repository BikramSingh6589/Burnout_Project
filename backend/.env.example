# Backend environment example for Burnout Platform
# Copy to .env and fill values before running

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/burnout_db

# Server settings
PORT=5001

# Email (used by nodemailer)
# For Gmail: set an app password or use an SMTP relay
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Optional: recipient for test emails
TEST_EMAIL_RECIPIENT=admin@example.com
# Backend Environment Configuration
# Copy this file to .env and replace placeholder values.

# Port where the Express backend listens.
PORT=5001

# MongoDB Atlas connection string.
# Replace <username>, <password>, and <database> with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority

# OPTIONAL: DNS servers used for MongoDB Atlas SRV lookups.
# Keep this if your local DNS returns querySrv ECONNREFUSED.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT secret used for signing tokens.
JWT_SECRET=your_jwt_secret_here

# Google OAuth credentials for Google Sign-In.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OPTIONAL: Email account credentials for future email features.
# If one value is provided, both must be set.
# For Gmail, use an app password, not your normal account password.
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=Burnout Wellness <your_email@example.com>

# Frontend base URL for email CTAs (wellness notifications, weekly reminders).
# Used for "View My Dashboard" links: {FRONTEND_URL}/dashboard
# FRONTEND_URL is preferred; APP_URL is supported as a fallback.
FRONTEND_URL=https://your-domain.com
# APP_URL=https://your-domain.com

# Local development environment.
NODE_ENV=development

# Groq AI API for journal sentiment analysis.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
